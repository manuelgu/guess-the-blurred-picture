{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guess-the-blurred-picture",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Per-version preview URLs would expose old builds; turn on if you want branch previews.
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "guess-the-blurred-picture-images" }],
  "d1_databases": [{ "binding": "DB", "database_name": "guess-the-blurred-picture" }],
  "observability": { "enabled": true }
}
